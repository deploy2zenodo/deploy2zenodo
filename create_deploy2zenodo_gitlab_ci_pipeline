#!/usr/bin/env sh
set -e

#    create_deploy2zenodo_gitlab_ci_pipeline
#    Copyright (C) 2023-2026 Daniel Mohr

echo "run create_deploy2zenodo_gitlab_ci_pipeline"

IN=deploy2zenodo
OUT=deploy2zenodo.yaml

VERSION=$(sed -n 's/^#.*Version:[[:space:]]*\([^[:space:]]*\)$/\1/p' "$IN")
URL=$(sed -n 's/^home:[[:space:]]*\(https:[^[:space:]]*\)$/\1/p' README.md)
script=$(sed -n '/^#    deploy2zenodo$/,/^# stop deploy2zenodo$/p' $IN | \
             sed '/^VERSION=.*$/d' | \
             sed "s#v\$VERSION#v$VERSION $URL/-/releases/$VERSION#g" | \
             sed "s#\"\$VERSION\"#\"$VERSION\"#g" | \
             sed '/^DEPLOY2ZENODO_DOI=.*$/d' | \
             sed '/^[[:space:]]*$/d' | \
             sed 's/^/      /')

if [ -n "$DOI" ]; then
    # replace concept DOI by actual DOI given in the variable DOI:
    CONCEPTDOI="10.5281/zenodo.10112959"
    # since 'space' can not be part of a DOI we use space as separator in sed:
    script=$(printf '%s\n' "$script" | sed "s $CONCEPTDOI $DOI g" | \
                 sed "s#\$DEPLOY2ZENODO_DOI#$DOI#g")
else
    DEPLOY2ZENODO_DOI=$(sed -n 's/^#.*DOI:[[:space:]]*\([^[:space:]]*\)$/\1/p' "$IN")
    script=$(printf '%s\n' "$script" | sed '/^DEPLOY2ZENODO_DOI=.*$/d' | \
                 sed "s#\$DEPLOY2ZENODO_DOI#$DEPLOY2ZENODO_DOI#g")
fi

cat >$OUT <<EOL
.deploy2zenodo:
  script:
    - |
$script

.deploy2zenodo_alpine:
  image:
    name: alpine:latest
  before_script:
    - apk add --no-cache curl jq
  extends: .deploy2zenodo

deploy2zenodo:
  stage: .post
  extends: .deploy2zenodo_alpine
EOL

echo "'$OUT' created."
